# LLM Configuration
OPENAI_API_KEY=your_openai_key_here
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
USE_OLLAMA=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Google Gemini Fallback Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# LM Studio Local Execution (OpenAI-compatible local server)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen3-8b-claude-sonnet-4-reasoning-distill

# Database Connection
DATABASE_URL=sqlite:///./research_assistant.db
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/research_assistant

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./chroma_db

# Repository Path
REPOSITORY_BASE_PATH=./repository

# Security & Auth
JWT_SECRET=super_secret_jwt_key_change_me
JWT_EXPIRE_MINUTES=1440

# App Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
